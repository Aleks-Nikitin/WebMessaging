
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
 model User {
  id Int @id @default(autoincrement())
  firstname String 
  lastname String
  password String
  email String @unique
  messages Message[]
  chats Chat[]
 }
 model Chat{
  id Int @id @default(autoincrement())
  users User[]
 }
 model Message{
  id Int @id @default(autoincrement())
  user User @relation(fields: [userId],references: [id])
  userId Int
  text String 
 }